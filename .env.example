# ---------- copie pra .env e preencha ----------
NODE_ENV=development

# API
API_PORT=3333
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:3333

# Banco. directConnection=true e obrigatorio: sem ele o driver tenta resolver
# o host anunciado pelo replica set ("mongo:27017"), que nao existe fora do Docker.
DATABASE_URL="mongodb://localhost:27017/gravae?directConnection=true"
# 127.0.0.1 explícito (não "localhost") pra não cair no IPv6 e achar outro Redis
REDIS_URL="redis://127.0.0.1:6381"

# Sessao (troque por valores aleatorios: openssl rand -hex 32)
JWT_SECRET=troque-isto-por-32-bytes-aleatorios
COOKIE_SECRET=troque-isto-tambem-por-32-bytes

# Google OAuth (console.cloud.google.com > APIs & Services > Credentials)
# Redirect URI autorizada: http://localhost:3333/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Busca de GIF (KLIPY). A Tenor foi desligada pelo Google em 30/06/2026.
# Chave gratuita em https://partner.klipy.com > API Keys > Add Platform.
# A chave de teste ja funciona (100 chamadas/hora); producao e so pedir no painel.
# Sem a chave, a aba de GIF explica o que falta e colar link continua funcionando.
KLIPY_API_KEY=


# ---------- Storage: Cloudflare R2 (ou qualquer S3) ----------
# Em producao/dev usamos R2. Para rodar offline, suba o MinIO do compose e
# aponte R2_ENDPOINT para http://localhost:9000.
R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
# Prefixo das chaves — isola os arquivos deste app dentro do bucket
R2_PREFIX=gravae-chat
# Upload direto do navegador pro bucket (mais barato). Exige politica de CORS no
# painel do R2 — enquanto nao houver, deixe false e o arquivo sobe pela API.
# Depois de configurar: node apps/api/scripts/setup-r2-cors.mjs mostra a politica.
R2_DIRECT_UPLOAD=false

# LiveKit (Fase 3)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-precisa-ter-no-minimo-32-caracteres

# Metricas da MAQUINA onde o LiveKit roda, pro bloco "Voz" do painel de servidor.
# So faz sentido quando o SFU esta em outra maquina: em desenvolvimento ele sobe
# no docker-compose daqui mesmo, e vazio o painel simplesmente nao mostra o bloco.
# Pra ligar em producao: infra/sfu/instalar.sh (ele imprime as duas linhas).
SFU_STATUS_URL=
SFU_STATUS_TOKEN=

# Liga so no staging, onde o front (Vercel) e a API (DuckDNS) sao dominios
# diferentes: sem isto o cookie de sessao sai como SameSite=Lax e o navegador
# nao o manda para o outro site — a pessoa entra e cai na primeira renovacao.
# Em producao fica desligado, porque la os dois respondem pela mesma origem.
COOKIE_ENTRE_SITES=false

# Aceita qualquer *.vercel.app como origem. So no staging: a Vercel da uma URL
# nova a cada previa, e fixar uma no WEB_ORIGIN quebraria o CORS na seguinte.
ACEITAR_PREVIAS_VERCEL=false

# Correio da casa. Com a chave do Resend preenchida, a API manda o e-mail de
# "esqueci a senha" — e a tela de entrar passa a oferecer o link. Vazia, a rota
# responde 503 e a tela nem mostra a opcao.
#
# A chave sai de resend.com/api-keys. O remetente de fabrica e o endereco de
# teste do proprio Resend, que nao depende de dominio nenhum — bom pra provar o
# fluxo. Pro e-mail chegar em qualquer pessoa, e nao so na caixa da conta, ai
# sim e preciso verificar um dominio e trocar a linha de baixo.
RESEND_API_KEY=
EMAIL_REMETENTE=Gravae <onboarding@resend.dev>

# Frontend
# Vazio = mesma origem (proxy do Vite). Só preencha se a API estiver noutro domínio.
VITE_API_URL=
VITE_WS_URL=

# Aplicativo de desktop (Fase 5)
# Onde a janela do Electron carrega o Gravae. Vazio = http://localhost:5173.
# Depois da Fase 6, aponte pro endereco publico.
GRAVAE_APP_URL=

# Convite do servidor oficial do Gravae. Vazio = a faixa de convite no topo do
# app nao aparece pra ninguem.
VITE_CONVITE_OFICIAL=

# Central de ajuda. Vazio = o botao "Saiba mais" no rodape da conversa oficial
# nao aparece.
VITE_AJUDA_URL=

# Dono do servidor "Gravae Developers". Preencha com o e-mail da conta que vai
# ser dona dele: a API cria a comunidade na subida, marca como verificada e
# detectavel, e abre os canais. Vazio = nada e criado.
SERVIDOR_DE_DESENVOLVEDORES_DONO=

# Dono do servidor "Gravae HQ", a casa oficial. Mesma ideia do de cima: a API
# cria, marca como verificada e detectavel, e abre os canais de novidades,
# ajuda, estado da plataforma e conversa. Vazio = nada e criado.
SERVIDOR_DA_CASA_DONO=
