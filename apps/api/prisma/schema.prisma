generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum ChannelType {
  TEXT
  VOICE
  FORUM
}

enum ContentVisibility {
  DEFAULT
  SPOILER
  AGE_RESTRICTED
}

enum VideoQuality {
  AUTO
  HD
}

enum MessageType {
  USER
  JOIN
  COMANDO
}

enum AutoModTrigger {
  WORDS
  MENTION_SPAM
  LINKS
}

enum AutoModAction {
  BLOCK
  ALERT
  TIMEOUT
}

enum PresenceStatus {
  ONLINE
  IDLE
  DND
  OFFLINE
}

enum OverwriteType {
  ROLE
  MEMBER
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

type Attachment {
  id          String
  url         String
  filename    String
  contentType String
  size        Int
  width       Int?
  height      Int?
  spoiler     Boolean @default(false)
  description String?
  duracaoMs   Int?
  ondas       String?
}

type PollOption {
  id      String
  texto   String
  emoji   String?
  userIds String[] @db.ObjectId
}

type Poll {
  pergunta    String
  opcoes      PollOption[]
  multiSelect Boolean     @default(false)
  expiresAt   DateTime?
  closedAt    DateTime?
}

model User {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  email       String         @unique
  username    String         @unique
  displayName String
  avatarUrl   String?
  bio         String?
  pronomes    String?
  isBot       Boolean        @default(false)
  sistema     Boolean?
  senhaHash   String?
  status      PresenceStatus @default(OFFLINE)
  perfil              EstiloDePerfil?
  statusPersonalizado StatusPersonalizado?
  lastSeenAt  DateTime?

  aceitaPedidos   Boolean @default(true)
  mostraAtividade Boolean @default(true)

  mostraServidoresEmComum Boolean @default(true)
  mostraAmigosEmComum     Boolean @default(true)

  excluirEm DateTime?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  accounts            Account[]
  refreshTokens       RefreshToken[]
  memberships         GuildMember[]
  ownedGuilds         Guild[]        @relation("GuildOwner")
  messages            Message[]
  reactions           Reaction[]
  readStates          ReadState[]
  invitesCreated      Invite[]
  streamKeys          StreamKey[]
  friendshipsSent     Friendship[]   @relation("FriendshipRequester")
  friendshipsReceived Friendship[]   @relation("FriendshipAddressee")
  webhookIdentity     Webhook?       @relation("WebhookBot")
  webhooksCreated     Webhook[]      @relation("WebhookCreator")
  auditLogs           AuditLog[]     @relation("AuditActor")
  notasEscritas       UserNote[]     @relation("NotasEscritas")
  notasRecebidas      UserNote[]     @relation("NotasRecebidas")
  bans                Ban[]          @relation("BanTarget")
  forumPosts          ForumPost[]    @relation("PostAuthor")
  gifsFavoritos       GifFavorito[]
  mensagensFavoritas  MensagemFavorita[]
  botsCriados         Bot[]          @relation("BotOwner")
  temasPublicados     Tema[]         @relation("TemaAutor")
  botIdentity         Bot?           @relation("BotIdentity")
}

model Webhook {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId   String   @db.ObjectId
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId String   @db.ObjectId
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  name      String
  avatarUrl String?
  token     String   @unique
  botUserId String   @unique @db.ObjectId
  bot       User     @relation("WebhookBot", fields: [botUserId], references: [id], onDelete: Cascade)
  createdById String @db.ObjectId
  createdBy User     @relation("WebhookCreator", fields: [createdById], references: [id])
  createdAt DateTime @default(now())

  @@index([guildId])
  @@index([channelId])
}

model Account {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  supersededAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Guild {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  iconUrl     String?
  bannerUrl   String?
  description String?
  tag       String?
  tagIcon   String?
  systemChannelId String? @db.ObjectId
  welcomeEnabled  Boolean @default(true)
  welcomeMessage  String?
  categoria   String?
  descobrivel Boolean? @default(true)
  verificada  Boolean?
  ownerId   String   @db.ObjectId
  owner     User     @relation("GuildOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members    GuildMember[]
  categories Category[]
  channels   Channel[]
  invites    Invite[]
  events     GuildEvent[]
  roles      Role[]
  webhooks   Webhook[]
  bans       Ban[]
  auditLogs  AuditLog[]
  emojis     GuildEmoji[]
  stickers   GuildSticker[]
  sounds     GuildSound[]
  emblems    GuildEmblem[]
  automod    AutoModRule[]

  @@index([ownerId])
}

type EstiloDeNome {
  fonte  String?
  efeito String?
  cor    String?
  cor2   String?
}

type EstiloDePerfil {
  nome           EstiloDeNome?
  etiqueta       String?
  tagGuildId     String?  @db.ObjectId
  patente        String?
  decoracao      String?
  moldura        String?
  efeito         String?
  placa          String?
  bannerUrl      String?
  bannerCor      String?
  temaPrimario   String?
  temaSecundario String?
  conexoes       Conexao[]
}

type Conexao {
  servico String
  valor   String
}

type StatusPersonalizado {
  texto    String
  emoji    String?
  expiraEm DateTime?
}

model GuildMember {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId  String   @db.ObjectId
  guild    Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId   String   @db.ObjectId
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleIds  String[] @db.ObjectId
  emblemIds String[] @db.ObjectId
  nickname String?
  timeoutUntil DateTime?
  inviteCode String?
  invitedById String? @db.ObjectId
  joinedAt DateTime @default(now())

  @@unique([guildId, userId])
  @@index([userId])
}

model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId     String   @db.ObjectId
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name        String
  color       String?
  position    Int      @default(0)
  permissions String[]
  hoist       Boolean  @default(false)
  colorSecondary String?
  iconUrl        String?
  iconEmoji      String?
  estilo         String?
  mentionable Boolean  @default(false)
  isEveryone  Boolean  @default(false)
  createdAt   DateTime @default(now())

  overwrites PermissionOverwrite[]

  @@index([guildId, position])
}

model PermissionOverwrite {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  channelId String        @db.ObjectId
  channel   Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  targetId  String        @db.ObjectId
  role      Role?         @relation(fields: [targetId], references: [id], onDelete: Cascade)
  type      OverwriteType
  allow     String[]
  deny      String[]

  @@unique([channelId, targetId])
  @@index([channelId])
}

model Category {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  guildId  String  @db.ObjectId
  guild    Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name     String
  position Int     @default(0)

  channels Channel[]

  @@index([guildId, position])
}

model Channel {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  guildId    String?     @db.ObjectId
  guild      Guild?      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  categoryId String?     @db.ObjectId
  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name       String
  fonte      String?
  type       ChannelType @default(TEXT)
  topic      String?
  position   Int         @default(0)
  isPrivate  Boolean     @default(false)
  slowmodeSeconds Int    @default(0)
  contentVisibility ContentVisibility @default(DEFAULT)
  status     String?
  bitrate    Int         @default(64000)
  videoQuality VideoQuality @default(AUTO)
  userLimit  Int         @default(0)
  recipients String[]    @db.ObjectId
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  messages   Message[]
  readStates ReadState[]
  invites    Invite[]
  streamKeys StreamKey[]
  overwrites PermissionOverwrite[]
  webhooks   Webhook[]
  posts      ForumPost[]

  @@index([guildId, position])
  @@index([categoryId])
}

model Message {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  channelId   String       @db.ObjectId
  channel     Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId    String       @db.ObjectId
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content     String
  fonte       String?
  tipo        MessageType  @default(USER)
  attachments Attachment[]
  poll        Poll?
  stickerId   String?       @db.ObjectId
  sticker     GuildSticker? @relation(fields: [stickerId], references: [id], onDelete: SetNull)
  replyToId   String?      @db.ObjectId
  encaminhadaDeCanalId    String?  @db.ObjectId
  encaminhadaDeMensagemId String?  @db.ObjectId
  mentions    String[]     @db.ObjectId
  mentionRoleIds String[]  @db.ObjectId
  mentionEveryone Boolean?
  postId      String?      @db.ObjectId
  post        ForumPost?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  pinnedAt    DateTime?
  pinnedById  String?      @db.ObjectId
  createdAt   DateTime     @default(now())
  editedAt    DateTime?
  deletedAt   DateTime?

  reactions Reaction[]
  favoritada MensagemFavorita[]

  @@index([channelId, createdAt])
  @@index([postId, createdAt])
  @@index([channelId, pinnedAt])
  @@index([authorId])
}

model Reaction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  messageId String   @db.ObjectId
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  burst     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model ReadState {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId         String   @db.ObjectId
  channel           Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  lastReadMessageId String?  @db.ObjectId
  mentionCount      Int      @default(0)
  updatedAt         DateTime @updatedAt

  @@unique([userId, channelId])
  @@index([userId])
}

model Invite {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  code      String    @unique
  guildId   String    @db.ObjectId
  guild     Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId String?   @db.ObjectId
  channel   Channel?  @relation(fields: [channelId], references: [id], onDelete: SetNull)
  inviterId String    @db.ObjectId
  inviter   User      @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  uses      Int       @default(0)
  maxUses   Int?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([guildId])
}

model StreamKey {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId String   @db.ObjectId
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  lastUsedAt DateTime?

  @@unique([userId, channelId])
}

model Friendship {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  requesterId String           @db.ObjectId
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String           @db.ObjectId
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId    String   @db.ObjectId
  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  actorId    String   @db.ObjectId
  actor      User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  action     String
  targetType String
  targetId   String?
  targetName String?
  changes    Json?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([guildId, createdAt])
}

model Ban {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId     String   @db.ObjectId
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId      String   @db.ObjectId
  user        User     @relation("BanTarget", fields: [userId], references: [id], onDelete: Cascade)
  moderatorId String   @db.ObjectId
  reason      String?
  createdAt   DateTime @default(now())

  @@unique([guildId, userId])
  @@index([guildId])
}

model AutoModRule {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  guildId        String          @db.ObjectId
  guild          Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name           String
  enabled        Boolean         @default(true)
  trigger        AutoModTrigger
  palavras       String[]
  limiteMencoes  Int?
  acoes          AutoModAction[]
  alertChannelId String?         @db.ObjectId
  timeoutSeconds Int?
  cargosIsentos  String[]        @db.ObjectId
  createdAt      DateTime        @default(now())

  @@index([guildId])
}

model GuildEmoji {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId     String   @db.ObjectId
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name        String
  url         String
  animated    Boolean  @default(false)
  createdById String   @db.ObjectId
  createdAt   DateTime @default(now())

  @@unique([guildId, name])
  @@index([guildId])
}

model GuildSticker {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId       String   @db.ObjectId
  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  relatedEmoji  String
  url           String
  createdById   String   @db.ObjectId
  createdAt     DateTime @default(now())

  messages Message[]

  @@index([guildId])
}

model GuildSound {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId     String   @db.ObjectId
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name        String
  emoji       String?
  url         String
  volume      Float    @default(1)
  createdById String   @db.ObjectId
  createdAt   DateTime @default(now())

  @@index([guildId])
}

model ForumPost {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  channelId     String    @db.ObjectId
  channel       Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  guildId       String    @db.ObjectId
  authorId      String    @db.ObjectId
  author        User      @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title         String
  tags          String[]
  lastMessageAt DateTime  @default(now())
  messageCount  Int       @default(0)
  closedAt      DateTime?
  createdAt     DateTime  @default(now())

  messages Message[]

  @@index([channelId, lastMessageAt])
}

model UserNote {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  ownerId   String   @db.ObjectId
  owner     User     @relation("NotasEscritas", fields: [ownerId], references: [id], onDelete: Cascade)
  targetId  String   @db.ObjectId
  target    User     @relation("NotasRecebidas", fields: [targetId], references: [id], onDelete: Cascade)
  texto     String
  updatedAt DateTime @updatedAt

  @@unique([ownerId, targetId])
}

model GuildEmblem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId     String   @db.ObjectId
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  nome        String
  emoji       String?
  iconUrl     String?
  createdById String   @db.ObjectId
  createdAt   DateTime @default(now())

  @@index([guildId])
}

model GifFavorito {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gifId     String
  descricao String
  url       String
  preview   String
  width     Int
  height    Int
  createdAt DateTime @default(now())

  @@unique([userId, gifId])
  @@index([userId, createdAt])
}

model MensagemFavorita {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId String   @db.ObjectId
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, messageId])
  @@index([userId, createdAt])
}

model Bot {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  ownerId   String   @db.ObjectId
  owner     User     @relation("BotOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  botUserId String   @unique @db.ObjectId
  usuario   User     @relation("BotIdentity", fields: [botUserId], references: [id], onDelete: Cascade)
  token     String   @unique
  descricao String?
  permissoesPedidas String[]
  publico   Boolean  @default(true)
  clientSecret String @default("")
  redirectUris String[]
  comandos  Json?
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model StatusDoDia {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  peca    String
  dia     String
  medidas Int    @default(0)
  falhas  Int    @default(0)
  msSoma  Int    @default(0)

  atualizadoEm DateTime @updatedAt

  @@unique([peca, dia])
  @@index([dia])
}

model Tema {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nome      String
  descricao String?
  autor     String?
  versao    String?
  tags      String[] @default([])
  css       String
  substituicoes Json
  autorId   String   @db.ObjectId
  usuario   User     @relation("TemaAutor", fields: [autorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([autorId])
}

model GuildEvent {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  guildId          String    @db.ObjectId
  guild            Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  authorId         String    @db.ObjectId
  name             String
  description      String?
  imageUrl         String?
  startsAt         DateTime
  frequency        String    @default("once")
  channelId        String?   @db.ObjectId
  externalLocation String?
  interestedIds    String[]  @db.ObjectId
  startedAt        DateTime?
  canceledAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([guildId, startsAt])
}

model Denuncia {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tipo      String?
  guildId   String?  @db.ObjectId
  messageId String?  @db.ObjectId
  channelId String?  @db.ObjectId
  acusadoId String?  @db.ObjectId
  trecho    String?
  autorId   String   @db.ObjectId
  motivo    String
  detalhes  String?
  resolvidaEm  DateTime?
  resolvidaPor String?  @db.ObjectId
  decisao      String?
  createdAt DateTime @default(now())

  @@index([guildId])
  @@index([messageId])
  @@index([resolvidaEm])
}
