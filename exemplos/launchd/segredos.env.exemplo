# Copie para `segredos.env` e preencha. Esse arquivo fica de fora do git.
#
# Os três valores saem do app, em Configurações → Bots → GRAVAE MUSIC:
#   - o token, na aba Geral (aparece UMA vez; se perdeu, gere outro e o
#     antigo morre na hora)
#   - o id e o segredo, na aba OAuth2
GRAVAE_BOT_TOKEN=
GRAVAE_CLIENT_ID=
GRAVAE_CLIENT_SECRET=

# Onde a API responde. Local por enquanto; no dia da VPS, troque aqui.
GRAVAE_URL=http://localhost:3333
GRAVAE_APP=http://localhost:5173
